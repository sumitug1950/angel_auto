# Example nginx reverse proxy in front of the dashboard - TLS + basic auth, since this
# dashboard can place real orders once mode: live is armed. Not wired into docker-compose
# automatically (needs your actual domain + certs) - copy/adapt this on the VPS itself.
#
# Setup sketch:
#   1. Point a domain/subdomain's DNS A record at the VPS.
#   2. `sudo apt install nginx certbot python3-certbot-nginx`
#   3. Copy this file to /etc/nginx/sites-available/angel_auto, edit `server_name` below,
#      symlink into sites-enabled, `sudo nginx -t && sudo systemctl reload nginx`.
#   4. `sudo certbot --nginx -d your.domain.here` (handles TLS cert + auto-renewal + rewrites
#      this file to add the certificate/listen-443 blocks for you).
#   5. Basic auth: `sudo apt install apache2-utils && sudo htpasswd -c /etc/nginx/.htpasswd yourusername`
#      then uncomment the auth_basic lines below.

server {
    listen 80;
    server_name your.domain.here;

    location / {
        # auth_basic "angel_auto";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket upgrade for the live status feed (/ws/status)
    location /ws/ {
        # auth_basic "angel_auto";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
